# DeepSeek - powers the "Single chat" and "Compare models" tabs.
# https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenRouter - powers the "Free models" tab. Only zero-priced (:free) models
# are ever sent, so this key cannot be billed by this app.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
