# Copy to .env and fill in. .env is git-ignored; this file is not, so nothing
# real goes in here.

# The model the agent talks to. Required - server.py refuses to start without it.
# https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# The local model (llama.cpp) is configured in local_llm.json, not here.
# `uv run server.py` starts llama-server itself when that file says
# "autostart": true; 0 here overrides it (the tests do that).
LOCAL_LLM_AUTOSTART=1

# Day 31: the open project's MCP servers (git, files) are configured in
# project_mcp.json and started with the app through uvx and npx; 0 keeps them
# off (the tests do that).
PROJECT_MCP_AUTOSTART=1
