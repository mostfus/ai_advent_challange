# The VPS side of day 18: the events MCP server only. Copy to .env next to
# events_mcp_server.py on the server. No LLM key is needed there.

# Where it listens. 127.0.0.1 means the VPS itself only: nothing is open to
# the internet, and your machine reaches it through an SSH tunnel
# (ssh -N -L 8788:127.0.0.1:8788 you@your-vps). No root, no certificate.
EVENTS_HOST=127.0.0.1
EVENTS_PORT=8788

# Anything else running on the VPS can reach 127.0.0.1 too, so the server
# still asks for a token. Generate one:  openssl rand -hex 32
# and put the same value into EVENTS_MCP_TOKEN in the agent's .env at home.
EVENTS_TOKEN=

# How often the scheduler looks at the clock, in seconds.
EVENTS_TICK_SECONDS=30

# --- Only with root: serve HTTPS on the domain instead of the tunnel ---------
# `docker compose up -d` (it sets EVENTS_HOST=0.0.0.0 itself); the server then
# refuses to start without all of these, and EVENTS_TOKEN of 24+ characters.
# EVENTS_PUBLIC_HOST=events.example.com
# EVENTS_SSL_CERTFILE=/etc/letsencrypt/live/events.example.com/fullchain.pem
# EVENTS_SSL_KEYFILE=/etc/letsencrypt/live/events.example.com/privkey.pem
