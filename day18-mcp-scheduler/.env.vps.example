# The VPS side of day 18: the events MCP server only. Copy to .env next to
# docker-compose.yml on the server. No LLM key is needed there.

# Your domain - the name the agent will connect to. Requests for any other
# Host are refused.
EVENTS_PUBLIC_HOST=events.example.com

# The port the server listens on (open it in the firewall: ufw allow 8788/tcp).
EVENTS_PORT=8788

# The shared secret the agent sends as `Authorization: Bearer ...`.
# Generate it with:  openssl rand -hex 32
# and put the same value into EVENTS_MCP_TOKEN in the agent's .env.
EVENTS_TOKEN=

# The certificate for EVENTS_PUBLIC_HOST. These are certbot's paths; if yours
# live elsewhere, change them here and the /etc/letsencrypt mount in
# docker-compose.yml.
EVENTS_SSL_CERTFILE=/etc/letsencrypt/live/events.example.com/fullchain.pem
EVENTS_SSL_KEYFILE=/etc/letsencrypt/live/events.example.com/privkey.pem

# How often the scheduler looks at the clock, in seconds.
EVENTS_TICK_SECONDS=30
