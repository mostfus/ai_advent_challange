# Copy to .env and fill in. .env is git-ignored; this file is not, so nothing
# real goes in here.

# The model the agent talks to. Required - server.py refuses to start without it.
# https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Day 17, and only maps_mcp_server.py reads it. Optional: without it the app
# runs and the two Google Maps tools answer "no key" instead of a result.
# Needs the Routes API and Places API (New) enabled on the key's project:
# https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Day 18: where the events MCP server runs. Leave both empty to use a local
# one (`uv run events_mcp_server.py`, http://127.0.0.1:8788/mcp). For the one
# on your VPS, through the SSH tunnel (ssh -N -L 8788:127.0.0.1:8788 ...):
#   EVENTS_MCP_URL=http://127.0.0.1:8788/mcp
#   EVENTS_MCP_TOKEN=<the EVENTS_TOKEN from the VPS's .env>
# The token is sent as `Authorization: Bearer ...` and is never written under data/.
EVENTS_MCP_URL=
EVENTS_MCP_TOKEN=

# How often this app looks for digests the events server left (seconds; 0 = off).
DIGEST_POLL_SECONDS=30
