# Copy to .env and fill in. .env is git-ignored; this file is not, so nothing
# real goes in here.

# The model the agent talks to. Required - server.py refuses to start without it.
# https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Day 17, and only maps_mcp_server.py reads it. Optional: without it the app
# runs and the two Google Maps tools answer "no key" instead of a result.
# Needs the Routes API and Places API (New) enabled on the key's project:
# https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
